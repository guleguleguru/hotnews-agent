# ========================================
# HotNews Agent 配置示例
# ========================================
# 复制此文件为 .env 并填写你的配置

# ========================================
# LLM API 配置（支持 OpenAI / DeepSeek / 其他兼容 API）
# ========================================
# 使用 DeepSeek（推荐，便宜）⭐
OPENAI_API_KEY=your-deepseek-api-key-here
OPENAI_MODEL=deepseek-chat
OPENAI_BASE_URL=https://api.deepseek.com

# 或使用 OpenAI（更贵但质量更高）
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4-turbo-preview
# OPENAI_BASE_URL=https://api.openai.com/v1

# ========================================
# 邮件推送配置
# ========================================
# 方式 1: SMTP（推荐 Gmail/Outlook）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=your-email@gmail.com
MAIL_TO=recipient1@example.com,recipient2@example.com

# 方式 2: SendGrid（推荐用于生产环境）
# SENDGRID_API_KEY=your-sendgrid-api-key
# MAIL_FROM=noreply@yourdomain.com
# MAIL_TO=recipient@example.com

# ========================================
# 时区和调度
# ========================================
TIMEZONE=America/New_York

# ========================================
# 过滤和推送配置
# ========================================
# 分数阈值（0.0-1.0）：0.3=更多新闻，0.4=推荐，0.5=严格，0.8=极严格
SCORE_THRESHOLD=0.4
TOPK=8

# ========================================
# 去重配置
# ========================================
# 标题相似度阈值（0.0-1.0）：用于去除不同来源的同一条新闻
# 0.75=75%相似（推荐），0.8=更严格，0.7=更宽松
TITLE_SIMILARITY_THRESHOLD=0.75
ENABLE_DEDUP=true
HISTORY_DB_PATH=./history/sent_news.db

# ========================================
# 费用与速率控制
# ========================================
MAX_ITEMS=12
MODEL_TIMEOUT=30

# ========================================
# 全文抓取配置（分层处理）
# ========================================
# 只对最终要发送的新闻抓取全文（0=抓取所有最终要发送的，>0=只抓取前N条）
# 例如：TOPK=8, FULL_TEXT_TOP_N=0 → 抓取所有8条；FULL_TEXT_TOP_N=5 → 只抓取前5条
FULL_TEXT_TOP_N=0
FULL_TEXT_MAX_PARAGRAPHS=3

# ========================================
# 摘要生成配置（灵活长度控制）
# ========================================
# SUMMARY_TARGET_LENGTH: 目标长度（建议值，LLM 会尽量接近）
# SUMMARY_MAX_LENGTH: 最大长度（硬上限，超过会截断，但会尽量在标点处截断）
SUMMARY_TARGET_LENGTH=60
SUMMARY_MAX_LENGTH=100

# ========================================
# SMTP 重试配置
# ========================================
SMTP_MAX_RETRIES=3
SMTP_RETRY_DELAY=2

