# ========================================
# NewsScore 原项目配置
# ========================================
# NewsScore 评分模型配置（根据 NewsScore 项目要求填写）
NEWSSCORE_MODEL_API_KEY=your-openai-api-key-here
NEWSSCORE_MODEL_NAME=gpt-4
NEWSSCORE_DATA_SOURCES=https://feeds.bbci.co.uk/news/world/rss.xml,https://rss.nytimes.com/services/xml/rss/nyt/World.xml

# ========================================
# HotNews Agent 层配置
# ========================================
# LLM API 配置（支持 OpenAI / DeepSeek / 其他兼容 API）
# 使用 DeepSeek（推荐，便宜）⭐
OPENAI_API_KEY=your-deepseek-api-key-here
OPENAI_MODEL=deepseek-chat
OPENAI_BASE_URL=https://api.deepseek.com

# 或使用 OpenAI（更贵但质量更高）
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4-turbo-preview
# OPENAI_BASE_URL=https://api.openai.com/v1

# 邮件推送配置（SMTP）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# 收件人邮箱（多个用逗号分隔，如：email1@qq.com,email2@163.com）
MAIL_TO=recipient1@example.com,recipient2@example.com
MAIL_FROM=your-email@gmail.com

# 或使用 SendGrid
# SENDGRID_API_KEY=your-sendgrid-key
# MAIL_FROM=noreply@yourdomain.com
# MAIL_TO=recipient@example.com

# 时区和调度
TIMEZONE=America/New_York

# 过滤和推送配置
# 分数阈值（0-100分制）：30=更多新闻，35=推荐（新评分标准下），40=严格，50=极严格
# 注意：新评分标准（分桶+愤世嫉俗Persona）更严格，系统会自动动态调整阈值（最低30）
SCORE_THRESHOLD=35
TOPK=8

# 去重配置
# 标题相似度阈值（0.0-1.0）：用于去除不同来源的同一条新闻
# 0.75=75%相似（推荐），0.8=更严格，0.7=更宽松
TITLE_SIMILARITY_THRESHOLD=0.75
# 去重时间窗口（天）：只检查最近N天内的记录，默认7天（同一条新闻7天后可以再次发送）
DEDUP_WINDOW_DAYS=7

# 费用与速率控制
MAX_ITEMS=12
MODEL_TIMEOUT=30

# 全文抓取配置（分层处理）
# 只对最终要发送的新闻抓取全文（0=抓取所有最终要发送的，>0=只抓取前N条）
# 例如：TOPK=8, FULL_TEXT_TOP_N=0 → 抓取所有8条；FULL_TEXT_TOP_N=5 → 只抓取前5条
# 建议：0（抓取所有最终要发送的新闻，因为数量已经很少了）
FULL_TEXT_TOP_N=0
FULL_TEXT_MAX_PARAGRAPHS=3  # 每篇最多提取段落数

# 摘要生成配置（灵活长度控制）
# SUMMARY_TARGET_LENGTH: 目标长度（建议值，LLM 会尽量接近，但可以根据内容需要调整）
# SUMMARY_MAX_LENGTH: 最大长度（硬上限，超过会截断，但会尽量在标点处截断）
# 建议：TARGET=60, MAX=100（给摘要足够的灵活性，避免截断）
SUMMARY_TARGET_LENGTH=60
SUMMARY_MAX_LENGTH=100

# SMTP 重试配置
SMTP_MAX_RETRIES=3
SMTP_RETRY_DELAY=2

# 语言配置
# 可选值: "zh" (中文) 或 "en" (英文)
# 默认: zh
LANGUAGE=zh

# 可选：去重和历史记录
ENABLE_DEDUP=true
HISTORY_DB_PATH=./history/sent_news.db

