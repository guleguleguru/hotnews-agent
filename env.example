# ========================================
# HotNews Agent Configuration Example
# ========================================
# Copy this file to .env and fill in your settings

# ========================================
# LLM API Configuration (OpenAI / DeepSeek / Other compatible APIs)
# ========================================
# Using DeepSeek (recommended - cheaper) ⭐
OPENAI_API_KEY=your-deepseek-api-key-here
OPENAI_MODEL=deepseek-chat
OPENAI_BASE_URL=https://api.deepseek.com

# Or use OpenAI (more expensive but higher quality)
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4-turbo-preview
# OPENAI_BASE_URL=https://api.openai.com/v1

# ========================================
# Email Configuration
# ========================================
# Option 1: SMTP (Recommended: Gmail/Outlook)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=your-email@gmail.com
MAIL_TO=recipient1@example.com,recipient2@example.com

# Option 2: SendGrid (Recommended for production)
# SENDGRID_API_KEY=your-sendgrid-api-key
# MAIL_FROM=noreply@yourdomain.com
# MAIL_TO=recipient@example.com

# ========================================
# Timezone and Scheduling
# ========================================
TIMEZONE=America/New_York

# ========================================
# Filtering and Delivery Configuration
# ========================================
# Score threshold (0-100 scale): 30=more articles, 35=recommended (for new scoring system), 40=strict, 50=very strict
# Note: New scoring system (Tier-based + Cynical Persona) is stricter. System auto-adjusts threshold (min 30)
SCORE_THRESHOLD=35
TOPK=8

# ========================================
# Deduplication Configuration
# ========================================
# Title similarity threshold (0.0-1.0): Used to remove duplicate articles from different sources
# 0.75=75% similarity (recommended), 0.8=stricter, 0.7=more lenient
TITLE_SIMILARITY_THRESHOLD=0.75
ENABLE_DEDUP=true
HISTORY_DB_PATH=./history/sent_news.db
# Deduplication window (days): Only check records from the last N days (default 7)
# Same article can be sent again after N days
DEDUP_WINDOW_DAYS=7

# ========================================
# Cost and Rate Control
# ========================================
MAX_ITEMS=12
MODEL_TIMEOUT=30

# ========================================
# Full-Text Extraction Configuration (Two-Layer Processing)
# ========================================
# Only fetch full text for articles that will be sent (0=fetch all, >0=fetch first N only)
# Example: TOPK=8, FULL_TEXT_TOP_N=0 → fetch all 8; FULL_TEXT_TOP_N=5 → fetch first 5 only
FULL_TEXT_TOP_N=0
FULL_TEXT_MAX_PARAGRAPHS=3

# ========================================
# Summary Generation Configuration (Flexible Length Control)
# ========================================
# SUMMARY_TARGET_LENGTH: Target length (suggested value, LLM will try to match)
# SUMMARY_MAX_LENGTH: Maximum length (hard limit, will truncate if exceeded, but tries to cut at punctuation)
SUMMARY_TARGET_LENGTH=60
SUMMARY_MAX_LENGTH=100

# ========================================
# SMTP Retry Configuration
# ========================================
SMTP_MAX_RETRIES=3
SMTP_RETRY_DELAY=2
